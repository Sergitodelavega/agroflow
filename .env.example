# Copy to .env.local — never commit real secrets.

# --- Supabase (cloud) ---
# Leave empty to keep the localStorage demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Payments (Kkiapay sandbox) ---
# Set to "sandbox" to show the test payment UI. Any other value keeps it hidden.
VITE_PAYMENTS=
# Public widget key only. Private / secret keys stay on the server later.
VITE_KKIAPAY_PUBLIC_KEY=
# Always true for this prototype — never charge real money from the front.
VITE_KKIAPAY_SANDBOX=true
